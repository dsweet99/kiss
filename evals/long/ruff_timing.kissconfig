# Generated by kiss check
# Thresholds based on max values of analyzed codebase

[global]
min_similarity = 0.9
duplication_enabled = false
comment_removal_enabled = false
docs_allowed = ["./"]
orphan_allowed = []

[python]
statements_per_function = 82
positional_args = 9
keyword_only_args = 6
max_indentation = 8
nested_function_depth = 1
returns_per_function = 7
return_values_per_function = 6
branches_per_function = 19
local_variables = 36
statements_per_try_block = 6
boolean_parameters = 3
decorators_per_function = 1
calls_per_function = 55
methods_per_class = 10
statements_per_file = 335
lines_per_file = 1200
functions_per_file = 41
interface_types_per_file = 1
concrete_types_per_file = 12
imported_names_per_file = 24
indirect_dependencies = 8
dependency_depth = 3
cycle_size = 2

[rust]
statements_per_function = 859
arguments = 16
max_indentation = 12
nested_function_depth = 5
returns_per_function = 82
branches_per_function = 1586
local_variables = 184
boolean_parameters = 3
attributes_per_function = 2
calls_per_function = 945
methods_per_class = 242
statements_per_file = 3207
lines_per_file = 13025
functions_per_file = 1071
interface_types_per_file = 8
concrete_types_per_file = 107
imported_names_per_file = 320
indirect_dependencies = 280
dependency_depth = 6
cycle_size = 60

[test]
test_coverage_threshold = 0
test_coverage_scope = "codebase"
orphan_detection = false
max_num_tests = 999999
num_jobs = 64
num_jobs_pytest = 16
num_jobs_llvm_cov = 16
watch_settle_seconds = 1.0
pytest_plugins = []
ignore = ["crates/ruff_benchmark", "resources", "ty_completion_eval", "ty_benchmark"]
max_unit_test_seconds = { "*" = 99999 }

