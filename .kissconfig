# Generated by kiss / hand-maintained repo thresholds

[global]
orphan_module_enabled = true
duplication_enabled = true
min_similarity = 0.9

[test]
test_coverage_scope = "by_file"
test_coverage_threshold = 75
max_num_tests = 2875
num_jobs = 32
watch_settle_seconds = 1.0
pytest_plugins = []
ignore = []

[test.max_unit_test_seconds]
"*" = 15

[python]
boolean_parameters = 2
branches_per_function = 7
calls_per_function = 20
concrete_types_per_file = 1
cycle_size = 0
decorators_per_function = 2
dependency_depth = 3
functions_per_file = 10
imported_names_per_file = 13
indirect_dependencies = 7
interface_types_per_file = 1
keyword_only_args = 2
lines_per_file = 179
local_variables = 13
max_indentation = 4
methods_per_class = 1
nested_function_depth = 1
positional_args = 3
return_values_per_function = 3
returns_per_function = 5
statements_per_file = 87
statements_per_function = 24
statements_per_try_block = 2

[rust]
arguments = 8
attributes_per_function = 2
boolean_parameters = 1
branches_per_function = 9
calls_per_function = 45
concrete_types_per_file = 8
cycle_size = 0
dependency_depth = 4
functions_per_file = 25
imported_names_per_file = 32
indirect_dependencies = 149
interface_types_per_file = 1
lines_per_file = 427
local_variables = 17
max_indentation = 5
methods_per_class = 10
nested_function_depth = 2
returns_per_function = 5
statements_per_file = 200
statements_per_function = 30
